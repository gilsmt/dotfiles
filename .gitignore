# Local-only overrides / secret material
*.local
*.local.*
secrets/
**/secrets/

# npm auth token — `npm login` writes it to ~/.npmrc, keep it out of git
.npmrc.local
**/.npmrc.local

# gh CLI OAuth token
**/hosts.yml

# agent CLI credential stores
**/auth.json
**/credentials.json

# opencode service password
**/service.json

# API keys and private key material
**/*api-key*
**/*.pem
id_rsa
id_ed25519

# Runtime state
*.log
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
